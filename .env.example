# RESEND_API_KEY
# RESEND_FROM
# STRIPE_TEST_SECRET_KEY (sk_test_ or restricted rk_test_)
# STRIPE_TEST_WEBHOOK_SECRET (endpoint: /webhooks/stripe/test)
# STRIPE_TEST_PORTAL_CONFIGURATION_ID
# STRIPE_LIVE_SECRET_KEY (sk_live_ or restricted rk_live_; configure only after approval)
# STRIPE_LIVE_WEBHOOK_SECRET (endpoint: /webhooks/stripe/live)
# STRIPE_LIVE_PORTAL_CONFIGURATION_ID
# Legacy STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET are accepted only when the
# key prefix matches the requested environment; there is never cross-environment fallback.
